rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // PHASE 0B CONTAINMENT: fail closed. The live project currently has no
    // Firebase Rules release, which also denies client access. Keep the checked
    // in policy deny-all until server-derived organization ownership and its
    // cross-tenant emulator tests are implemented and separately reviewed.
    // Admin SDK access bypasses these client rules and still requires IAM and
    // application-layer authorization.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
