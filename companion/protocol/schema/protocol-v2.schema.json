{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://transcriptor.invalid/protocol-v2.schema.json",
  "title": "T.A.R.S. companion protocol v2 offline boundary",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocolVersion", "eventType", "sessionId", "streamId", "source", "captureGeneration", "eventId"],
  "properties": {
    "protocolVersion": {"const": 2},
    "eventType": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "sessionId": {"$ref": "#/$defs/identifier"},
    "streamId": {"$ref": "#/$defs/identifier"},
    "source": {"enum": ["microphone", "system_audio"]},
    "captureGeneration": {"$ref": "#/$defs/uint64Decimal"},
    "eventId": {"$ref": "#/$defs/identifier"},
    "sequence": {"$ref": "#/$defs/uint64Decimal"},
    "firstSample": {"$ref": "#/$defs/uint64Decimal"},
    "lastSampleExclusive": {"$ref": "#/$defs/uint64Decimal"},
    "sampleRateHertz": {"type": "integer", "minimum": 8000, "maximum": 48000},
    "channelCount": {"enum": [1, 2]},
    "durationMs": {"type": "integer", "minimum": 20, "maximum": 250},
    "payloadBytes": {"type": "integer", "minimum": 1, "maximum": 64000},
    "payloadDigestSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "encoding": {"const": "pcm_s16le"},
    "stageIntervals": {"type": "array", "items": {"$ref": "#/$defs/interval"}, "maxItems": 100, "uniqueItems": true},
    "derivedContiguousPrefix": {"anyOf": [{"$ref": "#/$defs/interval"}, {"type": "null"}]},
    "coverageIds": {"type": "array", "items": {"$ref": "#/$defs/identifier"}, "minItems": 1, "maxItems": 100, "uniqueItems": true},
    "textFirstSample": {"$ref": "#/$defs/uint64Decimal"},
    "textLastSampleExclusive": {"$ref": "#/$defs/uint64Decimal"},
    "providerResultOrdinal": {"$ref": "#/$defs/uint64Decimal"},
    "providerName": {"$ref": "#/$defs/identifier"},
    "providerResultId": {"$ref": "#/$defs/identifier"}
  },
  "allOf": [
    {
      "if": {"properties": {"eventType": {"const": "audio.chunk"}}, "required": ["eventType"]},
      "then": {
        "required": [
          "sequence",
          "firstSample",
          "lastSampleExclusive",
          "sampleRateHertz",
          "channelCount",
          "durationMs",
          "payloadBytes",
          "payloadDigestSha256",
          "encoding"
        ]
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "uint64Decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,18}|1[0-7][0-9]{18}|18[0-3][0-9]{17}|184[0-3][0-9]{16}|1844[0-5][0-9]{15}|18446[0-6][0-9]{14}|184467[0-3][0-9]{13}|1844674[0-3][0-9]{12}|184467440[0-6][0-9]{10}|1844674407[0-2][0-9]{9}|18446744073[0-6][0-9]{8}|1844674407370[0-8][0-9]{6}|18446744073709[0-4][0-9]{5}|184467440737095[0-4][0-9]{4}|18446744073709550[0-9]{3}|18446744073709551[0-5][0-9]{2}|1844674407370955160[0-9]|1844674407370955161[0-5])$",
      "maxLength": 20
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["firstSequence", "lastSequenceInclusive", "firstSample", "lastSampleExclusive"],
      "properties": {
        "firstSequence": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
        "lastSequenceInclusive": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
        "firstSample": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20},
        "lastSampleExclusive": {"type": "string", "pattern": "^(0|[1-9][0-9]*)$", "maxLength": 20}
      }
    }
  }
}
