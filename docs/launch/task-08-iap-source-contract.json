{
  "contract": "task-08-iap-source",
  "version": 1,
  "status": "SOURCE_ONLY_NON_AUTHORIZING",
  "provider_state": false,
  "topology": {
    "frontend": {
      "service": "Firebase App Hosting",
      "origin": "https://tars.ellaexecutivesearch.com",
      "browser_only": true
    },
    "api": {
      "service": "Cloud Run behind IAP",
      "origin": "https://api.tars.ellaexecutivesearch.com",
      "websocket_origin": "wss://api.tars.ellaexecutivesearch.com",
      "direct_paths": ["/api/", "/ws", "/api/stream/native"]
    },
    "native_desktop": {
      "iap_session_flow": false,
      "admitted_in_iap_mode": false,
      "qualification": "UNQUALIFIED_FAIL_CLOSED"
    }
  },
  "origins": {
    "frontend_https": "https://tars.ellaexecutivesearch.com",
    "api_https": "https://api.tars.ellaexecutivesearch.com",
    "api_wss": "wss://api.tars.ellaexecutivesearch.com",
    "ws_path": "/ws",
    "native_stream_path": "/api/stream/native",
    "same_site_hosts_required": true,
    "proxy_relative_paths_forbidden": true
  },
  "cors": {
    "application_allowed_origins": ["https://tars.ellaexecutivesearch.com"],
    "provider_iap_access_settings": {
      "allow_http_options": true,
      "configured": false,
      "proven": false,
      "authorized_by_source_task": false
    }
  },
  "admission": {
    "exact_unique_address_count": 5,
    "required_domain": "ellaexecutivesearch.com",
    "server_derived_org_id": "ella-internal",
    "operator_set_nonempty_subset": true
  },
  "cloud_run_iam": {
    "public_principal": false,
    "invoker_role": "roles/run.invoker",
    "allowed_invoker_principals": ["service-PROJECT_NUMBER@gcp-sa-iap.iam.gserviceaccount.com"],
    "allowed_invoker_count": 1
  },
  "provider_gates": {
    "cloud_run_max_instances": {
      "required_value": 1,
      "configured": false,
      "proven": false,
      "source_authorized": false,
      "authorized_by_source_task": false
    },
    "serving_revision_count": {
      "required_value": 1,
      "configured": false,
      "proven": false,
      "source_authorized": false,
      "authorized_by_source_task": false
    },
    "traffic": {
      "required_unsplit_percent": 100,
      "configured": false,
      "proven": false,
      "source_authorized": false,
      "authorized_by_source_task": false
    },
    "session_affinity": {
      "required": true,
      "assumption": "routing remains pinned to the single process instance for process-local tickets, sessions, kill, and readiness",
      "configured": false,
      "proven": false,
      "source_authorized": false,
      "authorized_by_source_task": false
    }
  },
  "iap": {
    "issuer": "https://cloud.google.com/iap",
    "audience_template": "/projects/PROJECT_NUMBER/locations/REGION/services/SERVICE_NAME",
    "signed_header": "x-goog-iap-jwt-assertion",
    "unsigned_identity_headers_authority": false,
    "gcip": {
      "encoding": "bounded JSON string",
      "duplicate_keys": "reject",
      "required_fields": ["sub", "email", "email_verified", "auth_time"],
      "firebase": {"sign_in_provider": "google.com"},
      "top_level_provider_accepted": false
    },
    "jwt_max_lifetime_seconds": 600,
    "clock_skew_seconds": 30,
    "signout_query": "gcp-iap-mode=GCIP_SIGNOUT"
  },
  "websocket": {
    "absolute_max_lifetime_seconds": 3300,
    "fresh_http_ticket_on_reconnect": true,
    "fresh_iap_assertion_on_reconnect": true,
    "ping_extends_deadline": false,
    "logout_and_kill_close": true
  },
  "frontend_terminal_lifecycle": {
    "terminal_http_statuses": [401, 403],
    "authenticated_data_unmount_required": true,
    "logout_max_wait_ms": 5000,
    "stale_attempt_fence_required": true,
    "late_media_disposal_required": true,
    "retryable_failures": ["5xx", "network"]
  },
  "evidence_ceiling": {
    "allowed": ["source inspection", "offline unit tests", "synthetic fixtures", "CI/simulator evidence"],
    "not_proven": ["Identity Platform", "IAP", "IAM", "DNS", "TLS", "cookies", "custom domains", "deployed WebSockets", "budgets", "quotas", "provider billing", "privacy/legal", "physical devices", "audible quality", "production readiness"],
    "native_desktop": "incompatible with this IAP candidate and remains unqualified"
  },
  "cost_proposal": {
    "currency": "BRL",
    "monthly_amount": 250,
    "kind": "alert_only_proposal",
    "hard_spending_limit": false,
    "provider_state": false,
    "thresholds_percent": [50, 90, 100],
    "recipient": "deli@ellaexecutivesearch.com"
  },
  "zero_active_categories": ["active_business_sessions", "registered_browser_sockets", "outstanding_browser_tickets", "active_stream_keys", "active_provider_operations"],
  "rollback_categories": [
    "frontend_release",
    "cloud_run_artifact",
    "cloud_run_revision",
    "cloud_run_traffic",
    "iam",
    "iap",
    "identity_platform",
    "origins_dns_tls",
    "api_key_restrictions",
    "runtime_configuration",
    "budgets",
    "quotas",
    "kill_switch",
    "evidence"
  ],
  "rollback_manifest_required": true,
  "active_session_gate_required": true,
  "provider_commands": "forbidden_in_source_candidate"
}
