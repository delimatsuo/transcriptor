# CURRENT LOCAL PROTOTYPE ONLY.
# This is not the target native-companion or production environment contract.
GOOGLE_CLOUD_PROJECT=your-project-id
# Firebase Admin uses the same project by default. Never commit service-account
# keys; the backend startup ADC probe is the only credential source.
FIREBASE_PROJECT_ID=your-project-id
# Exact comma-separated internal Google accounts admitted to this local app.
AUTH_ALLOWED_EMAILS=authorized-recruiter@example.com
AUTH_ORG_ID=ella-internal
EXTENSION_ENABLED=false
# Process-local Gemini concurrency budget; hosted quotas remain separate.
LLM_MAX_CONCURRENT_REQUESTS=2
# Explicit Vertex AI region; validate any change against the privacy checklist.
LLM_LOCATION=us-central1
# Deadline for each non-stream Gemini request; prevents a stuck provider call
# from holding the shared queue indefinitely.
LLM_REQUEST_TIMEOUT_SECONDS=60
# Maximum transcript characters sent to each rolling-summary update. The tail
# is retained because the prior rolling summary carries earlier context.
LLM_ROLLING_CONTEXT_MAX_CHARS=16000
LLM_ROLLING_FAILURE_BACKOFF_SECONDS=30
LLM_ROLLING_FAILURE_BACKOFF_MAX_SECONDS=300
# Fail closed before a final report can issue an unexpectedly large provider
# request. No transcript/context is silently truncated because evidence IDs
# must remain complete for the human review contract.
LLM_FINAL_REPORT_MAX_INPUT_CHARS=120000
# GCP auth via ADC: run `gcloud auth application-default login`
# Legacy prototype/default. Native system-audio capture is the target;
# BlackHole may remain a compatibility fallback only.
BLACKHOLE_DEVICE_NAME=BlackHole 2ch
# Microphone device name (empty = system default mic)
MICROPHONE_DEVICE_NAME=
FASTAPI_PORT=8000
# Only the WebSocket URL is configurable today. REST calls remain hardcoded to
# localhost and must gain an environment-based API URL before hosted use.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_API_URL=http://localhost:8000
SESSION_MAX_DURATION_MINUTES=180
# INERT POLICY PLACEHOLDER: this value is not enforced by a retention/deletion
# job and must not be represented as a current 90-day deletion guarantee.
DATA_RETENTION_DAYS=90
