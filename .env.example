# CURRENT LOCAL PROTOTYPE ONLY.
# This is not the target native-companion or production environment contract.
GOOGLE_CLOUD_PROJECT=your-project-id
# GCP auth via ADC: run `gcloud auth application-default login`
# Legacy prototype/default. Native system-audio capture is the target;
# BlackHole may remain a compatibility fallback only.
BLACKHOLE_DEVICE_NAME=BlackHole 2ch
# Microphone device name (empty = system default mic)
MICROPHONE_DEVICE_NAME=
FASTAPI_PORT=8000
# Only the WebSocket URL is configurable today. REST calls remain hardcoded to
# localhost and must gain an environment-based API URL before hosted use.
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
SESSION_MAX_DURATION_MINUTES=180
# INERT POLICY PLACEHOLDER: this value is not enforced by a retention/deletion
# job and must not be represented as a current 90-day deletion guarantee.
DATA_RETENTION_DAYS=90
