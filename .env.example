# T.A.R.S. Backend Environment Configuration Example
# Local development defaults. Cloud Run hosted runtime configuration is managed separately.

# GCP / Project Identity
GOOGLE_CLOUD_PROJECT=your-project-id
# Firebase Admin project ID; defaults to GOOGLE_CLOUD_PROJECT if not set.
FIREBASE_PROJECT_ID=your-project-id

# Authentication / Recruiter Access
# Exact comma-separated internal Google accounts admitted to this app.
# Real pilot allowlist is validated in Task 07 before deployment.
AUTH_ALLOWED_EMAILS=authorized-recruiter@example.com
AUTH_ORG_ID=ella-internal
# Runtime execution mode: local or hosted-pilot
TARS_RUNTIME_MODE=local
# Local development bypass toggle. Must stay false in hosted/pilot environments.
AUTH_BYPASS=false

# CORS Configuration
# Comma-separated list of allowed origins. If absent, local defaults (localhost:3000/3003) apply.
# In hosted environments, set to explicit Firebase Hosting origins (see docs/launch/cloud-run-pilot-source-readiness.md).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003,chrome-extension://fhnadcdkfgdlkomjpilmgehhpgmkjnga

# Google Cloud Storage
# Optional bucket override. If omitted, defaults to <GOOGLE_CLOUD_PROJECT>-tars.
GCS_BUCKET_NAME=your-project-id-tars

# Integrations & Audio Capture Safety Flags
EXTENSION_ENABLED=false
# Host audio capture on the server process (legacy mode; false for companion/browser capture)
HOST_AUDIO_CAPTURE_ENABLED=false
# Local audio backup recording (false by default per privacy policy)
AUDIO_BACKUP_ENABLED=false

# Gemini / Vertex AI Configuration
LLM_LOCATION=us-central1
LLM_MAX_CONCURRENT_REQUESTS=2
LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_INPUT_CHARS=120000
LLM_MAX_OUTPUT_TOKENS=8192
LLM_ROLLING_CONTEXT_MAX_CHARS=16000
LLM_ROLLING_FAILURE_BACKOFF_SECONDS=30
LLM_ROLLING_FAILURE_BACKOFF_MAX_SECONDS=300
LLM_FINAL_REPORT_MAX_INPUT_CHARS=120000

# Speech-to-Text (STT) Configuration
STT_LOCATION=us
STT_GRACEFUL_DRAIN_TIMEOUT_SECONDS=10.0

# Legacy Audio Device Settings (Local Capture Fallback Only)
BLACKHOLE_DEVICE_NAME=BlackHole 2ch
MICROPHONE_DEVICE_NAME=
MICROPHONE_INPUT_CHANNEL=0

# Server Host & Port
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Session Configuration
SESSION_MAX_DURATION_MINUTES=180
# INERT POLICY PLACEHOLDER: this value is not enforced by an automated retention/deletion
# job and must not be represented as a current 90-day deletion guarantee.
DATA_RETENTION_DAYS=90

# Frontend Environment Variables (Local Defaults)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_WS_STREAM_URL=ws://localhost:8000/api/stream/native
NEXT_PUBLIC_AUTH_BYPASS=0
