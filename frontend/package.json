    "test": "node --experimental-strip-types --import 'data:text/javascript,import%20%7B%20register%20%7D%20from%20%27node%3Amodule%27%3B%20import%20%7B%20pathToFileURL%20%7D%20from%20%27node%3Aurl%27%3B%20register%28%27data%3Atext%2Fjavascript%2Cexport%20async%20function%20resolve%28s%2C%20c%2C%20n%29%20%7B%20if%20%28%28s.startsWith%28%22.%2F%22%29%20%7C%7C%20s.startsWith%28%22..%2F%22%29%29%20%26%26%20%21s.endsWith%28%22.ts%22%29%20%26%26%20%21s.endsWith%28%22.js%22%29%29%20%7B%20try%20%7B%20return%20await%20n%28s%20%2B%20%22.ts%22%2C%20c%29%3B%20%7D%20catch%20%7B%7D%20%7D%20return%20n%28s%2C%20c%29%3B%20%7D%27%2C%20pathToFileURL%28%27.%2F%27%29%29%3B' --test src/lib/*.test.ts",
    "e2e": "playwright test",
    "e2e:auth-offline": "playwright test --config=playwright.auth.config.ts"
  },
  "dependencies": {
    "firebase": "^11.1.0",
    "next": "16.3.0",
