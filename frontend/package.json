{
  "name": "tars-frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "test": "node --experimental-strip-types --test src/lib/*.test.ts",
    "e2e": "playwright test",
    "verify:vendor": "node scripts/verify-gcip-iap-vendor.mjs",
    "pretest": "npm run verify:vendor",
    "prebuild": "npm run verify:vendor"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "next": "16.3.0",
    "promise-polyfill": "8.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "url-polyfill": "1.1.14",
    "whatwg-fetch": "3.6.20"
  },
  "overrides": {
    "nanoid": "3.3.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
