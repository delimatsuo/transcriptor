{
  "manifest_version": 3,
  "name": "T.A.R.S. Meeting Speaker Detector",
  "version": "1.0.0",
  "description": "Detects active speakers in Google Meet and sends events to T.A.R.S.",
  "key": "",
  "permissions": [
    "activeTab",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://meet.google.com/*",
    "http://localhost:8000/api/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://meet.google.com/*"],
      "js": ["content/meet-selectors.js", "content/meet-observer.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
